<?xml version="1.0" encoding="utf-8"?>
<!--
  数据线 安装包（WiX v5）。
  构建：见同目录 build-msi.sh
  说明：采用当前用户安装（Scope="perUser"），装到 %LOCALAPPDATA%\Programs\FeigeP2P。
        不装 Program Files 的原因：程序把收到的文件存在自己目录下的 received\，
        装进受保护的 Program Files 后非管理员运行将无法写入。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="数据线"
           Manufacturer="数据线"
           Version="2.4.0"
           UpgradeCode="8f2c5d31-6b47-4a9e-9c85-1d2b7f0e4a63"
           Scope="perUser"
           Language="2052"
           Codepage="65001">

    <SummaryInformation Description="数据线 · 局域网互传" Manufacturer="数据线" />

    <MajorUpgrade DowngradeErrorMessage="已经安装了更新版本的数据线，请先在「应用和功能」中卸载它。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- 控制面板「应用和功能」里的图标与说明 -->
    <Icon Id="AppIcon" SourceFile="..\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- 安装目录：%LOCALAPPDATA%\Programs\FeigeP2P（可写，收文件不受限） -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FeigeP2P" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="数据线" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="数据线" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="6E3A7C41-9D2B-4F58-8A11-3C7B5D9E2F04">
        <File Id="FeigeExe" Source="..\..\build\payload\FeigeP2P.exe" />
        <!-- 当前用户安装：KeyPath 必须是 HKCU 注册表项，不能是文件（ICE38） -->
        <RegistryValue Root="HKCU" Key="Software\Feige\FeigeP2P" Name="Version"
                       Type="string" Value="2.4.0" KeyPath="yes" />
      </Component>
      <!-- 收件目录先建好，用户装完立刻能收文件 -->
      <Component Id="ReceiveFolder" Guid="2B8D5A17-4C63-4E29-9F0A-7D6C1B8E3A55">
        <CreateFolder Directory="INSTALLFOLDER" />
        <!-- 卸载时清理用户目录层级（空目录才会被删，不会动别人的东西） -->
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Feige\FeigeP2P" Name="InstallDir"
                       Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- 开始菜单 + 桌面快捷方式；卸载时清理 -->
    <Component Id="Shortcuts" Directory="AppMenuFolder" Guid="9C4E1D72-5A8F-4B36-A2D9-6E1F7B3C8D20">
      <Shortcut Id="StartMenuShortcut"
                Name="数据线"
                Description="局域网互传 · 扫码配对"
                Target="[INSTALLFOLDER]FeigeP2P.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="DesktopShortcut"
                Directory="DesktopFolder"
                Name="数据线"
                Description="局域网互传 · 扫码配对"
                Target="[INSTALLFOLDER]FeigeP2P.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Feige\FeigeP2P" Name="Shortcuts"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- 完成后可直接启动 -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="立即运行数据线" />
    <CustomAction Id="LaunchApp" FileRef="FeigeExe" ExeCommand="" Return="asyncNoWait" />
    <UI>
      <!-- 只有勾选了「立即运行」才启动 -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" Order="1" />
    </UI>

  </Package>
</Wix>
